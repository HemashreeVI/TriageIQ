# Copy this file to .env and fill in the values. Never commit .env.

# Support inbox Gmail address
SUPPORT_EMAIL=
# Gmail app password for that inbox
SUPPORT_APP_PASSWORD=
# Where agent alerts are sent
AGENT_EMAIL=
# Your name, shown in the console
DASHBOARD_NAME=

# Filled in automatically by TriageIQ on first start
DASHBOARD_USER=
DASHBOARD_PASSWORD=
NTFY_TOPIC=
